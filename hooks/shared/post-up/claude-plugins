#!/usr/bin/env bash
#
# Sync Claude Code plugins to match ~/.dotfiles/claude-plugins.
# Idempotent: safe to run repeatedly. Installs missing plugins/marketplaces
# and uninstalls anything not declared in the manifest.

set -eo pipefail

# declare -A (associative arrays) needs bash >= 4. macOS permanently ships
# bash 3.2 at /bin/bash. hooks/dispatch.sh normalizes PATH so `env bash`
# resolves to a newer one when run via rcup; this is a clear error for the
# case of running this hook standalone outside that context.
if [ "${BASH_VERSINFO[0]}" -lt 4 ]; then
  echo "claude-plugins hook requires bash >= 4 (found $BASH_VERSION); install one via Homebrew (brew install bash) or run via ./script/setup" >&2
  exit 1
fi

manifest="$HOME/.dotfiles/claude-plugins"

command -v claude >/dev/null 2>&1 || exit 0
[ -f "$manifest" ] || exit 0

if ! command -v jq >/dev/null 2>&1; then
  echo "claude-plugins hook requires jq" >&2
  exit 1
fi

declare -a desired_plugins=()
declare -A marketplace_source=()
declare -A desired_marketplaces=()

while IFS= read -r line || [ -n "$line" ]; do
  line="${line%%#*}"
  line="${line#"${line%%[![:space:]]*}"}"
  line="${line%"${line##*[![:space:]]}"}"
  [ -z "$line" ] && continue

  read -r spec src _rest <<< "$line"
  case "$spec" in
    *@*) ;;
    *) echo "claude-plugins: invalid spec '$spec' (expected plugin@marketplace)" >&2; exit 1 ;;
  esac

  desired_plugins+=("$spec")
  mp="${spec##*@}"
  desired_marketplaces["$mp"]=1
  [ -n "${src:-}" ] && marketplace_source["$mp"]="$src"
done < "$manifest"

known="$HOME/.claude/plugins/known_marketplaces.json"
installed_file="$HOME/.claude/plugins/installed_plugins.json"

read_keys() {
  local file="$1" filter="$2"
  [ -f "$file" ] || return 0
  jq -r "$filter" "$file"
}

existing_marketplaces="$(read_keys "$known" 'keys[]')"
installed_plugins="$(read_keys "$installed_file" '.plugins | keys[]')"

contains() {
  local needle="$1"; shift
  local haystack="$1"
  [ -n "$haystack" ] && grep -qxF "$needle" <<< "$haystack"
}

# Drift check: warn (don't act) if settings.json declares a plugin enabled
# that isn't in this manifest. enabledPlugins can't express "should not be
# installed" — false only disables an already-installed plugin — so it
# can't be the sync source of truth. But "enabled there, absent here" is
# almost always an oversight (e.g. installed ad hoc via `/plugin`), and
# left unchecked it gets silently uninstalled below.
settings_file="$HOME/.claude/settings.json"
if [ -f "$settings_file" ]; then
  desired_plugins_str="$(printf '%s\n' "${desired_plugins[@]}")"
  while IFS= read -r enabled_spec; do
    [ -z "$enabled_spec" ] && continue
    if ! contains "$enabled_spec" "$desired_plugins_str"; then
      echo "claude-plugins: WARNING: '$enabled_spec' is enabled in $settings_file but missing from $manifest — it will be uninstalled below unless added there" >&2
    fi
  done < <(jq -r '.enabledPlugins // {} | to_entries[] | select(.value == true) | .key' "$settings_file")
fi

# Every desired marketplace needs a source — either declared in the manifest
# or already configured.
for mp in "${!desired_marketplaces[@]}"; do
  if [ -z "${marketplace_source[$mp]:-}" ] && ! contains "$mp" "$existing_marketplaces"; then
    echo "claude-plugins: marketplace '$mp' has no source declared and is not configured" >&2
    exit 1
  fi
done

# Add missing marketplaces.
for mp in "${!marketplace_source[@]}"; do
  if ! contains "$mp" "$existing_marketplaces"; then
    echo "claude-plugins: adding marketplace $mp (${marketplace_source[$mp]})"
    claude plugin marketplace add "${marketplace_source[$mp]}"
  fi
done

# Install missing plugins.
for spec in "${desired_plugins[@]}"; do
  if ! contains "$spec" "$installed_plugins"; then
    echo "claude-plugins: installing $spec"
    claude plugin install "$spec"
  fi
done

# Uninstall plugins not in the manifest.
if [ -n "$installed_plugins" ]; then
  while IFS= read -r spec; do
    [ -z "$spec" ] && continue
    keep=0
    for d in "${desired_plugins[@]}"; do
      [ "$d" = "$spec" ] && keep=1 && break
    done
    if [ "$keep" -eq 0 ]; then
      echo "claude-plugins: uninstalling $spec"
      claude plugin uninstall "$spec"
    fi
  done <<< "$installed_plugins"
fi

# Remove marketplaces no desired plugin references.
existing_marketplaces="$(read_keys "$known" 'keys[]')"
if [ -n "$existing_marketplaces" ]; then
  while IFS= read -r mp; do
    [ -z "$mp" ] && continue
    if [ -z "${desired_marketplaces[$mp]:-}" ]; then
      echo "claude-plugins: removing marketplace $mp"
      claude plugin marketplace remove "$mp"
    fi
  done <<< "$existing_marketplaces"
fi
