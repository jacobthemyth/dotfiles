#!/usr/bin/env bash
#
# Sync Claude Code plugins to match ~/.claude/settings.json.
# Idempotent: safe to run repeatedly. Installs missing marketplaces/plugins
# and uninstalls anything not declared in settings.json.
#
# settings.json is the single source of truth:
#   - .enabledPlugins  — the desired plugin set (a "plugin@marketplace" -> bool
#     map). `true` = install + keep; `false` = keep installed but disabled;
#     absent = uninstall.
#   - .extraKnownMarketplaces — marketplace sources (owner/repo, path, or URL).
#     A marketplace referenced by an enabled plugin but absent here is assumed
#     to be a built-in known marketplace (e.g. claude-plugins-official): we
#     skip adding it and let `claude plugin install` resolve it.

set -eo pipefail

# declare -A (associative arrays) needs bash >= 4. macOS permanently ships
# bash 3.2 at /bin/bash. hooks/dispatch.sh normalizes PATH so `env bash`
# resolves to a newer one when run via rcup; this is a clear error for the
# case of running this hook standalone outside that context.
if [ "${BASH_VERSINFO[0]}" -lt 4 ]; then
  echo "claude-plugins hook requires bash >= 4 (found $BASH_VERSION); install one via Homebrew (brew install bash) or run via ./script/setup" >&2
  exit 1
fi

settings_file="$HOME/.claude/settings.json"

command -v claude >/dev/null 2>&1 || exit 0
[ -f "$settings_file" ] || exit 0

if ! command -v jq >/dev/null 2>&1; then
  echo "claude-plugins hook requires jq" >&2
  exit 1
fi

# enabled: plugins to install and keep (enabledPlugins == true).
# present: plugins to keep installed (any enabledPlugins key, true or false);
#          `false` means "installed but disabled" — never uninstall those.
declare -a enabled_plugins=()
declare -a present_plugins=()
declare -A marketplace_source=()
declare -A desired_marketplaces=()

while IFS= read -r spec; do
  [ -z "$spec" ] && continue
  enabled_plugins+=("$spec")
done < <(jq -r '.enabledPlugins // {} | to_entries[] | select(.value == true) | .key' "$settings_file")

while IFS= read -r spec; do
  [ -z "$spec" ] && continue
  present_plugins+=("$spec")
  # A kept-but-disabled plugin still needs its marketplace available.
  desired_marketplaces["${spec##*@}"]=1
done < <(jq -r '.enabledPlugins // {} | keys[]' "$settings_file")

while IFS=$'\t' read -r mp src; do
  [ -z "$mp" ] && continue
  [ -n "$src" ] && marketplace_source["$mp"]="$src"
done < <(jq -r '.extraKnownMarketplaces // {} | to_entries[] | "\(.key)\t\(.value.source.repo // .value.source.path // .value.source.url // "")"' "$settings_file")

known="$HOME/.claude/plugins/known_marketplaces.json"
installed_file="$HOME/.claude/plugins/installed_plugins.json"

read_keys() {
  local file="$1" filter="$2"
  [ -f "$file" ] || return 0
  jq -r "$filter" "$file"
}

existing_marketplaces="$(read_keys "$known" 'keys[]')"
installed_plugins="$(read_keys "$installed_file" '.plugins | keys[]')"

contains() {
  local needle="$1"; shift
  local haystack="$1"
  [ -n "$haystack" ] && grep -qxF "$needle" <<< "$haystack"
}

# Add missing marketplaces. A marketplace with no declared source that isn't
# already configured is assumed built-in (e.g. claude-plugins-official) — skip
# it and let `claude plugin install` resolve it rather than failing the sync.
for mp in "${!desired_marketplaces[@]}"; do
  contains "$mp" "$existing_marketplaces" && continue
  if [ -z "${marketplace_source[$mp]:-}" ]; then
    echo "claude-plugins: marketplace '$mp' has no source in settings.json; assuming built-in"
    continue
  fi
  echo "claude-plugins: adding marketplace $mp (${marketplace_source[$mp]})"
  claude plugin marketplace add "${marketplace_source[$mp]}"
done

# Install missing plugins.
for spec in "${enabled_plugins[@]}"; do
  if ! contains "$spec" "$installed_plugins"; then
    echo "claude-plugins: installing $spec"
    claude plugin install "$spec"
  fi
done

# Uninstall installed plugins absent from settings.json. Plugins present as
# `false` are kept (installed but disabled), so only act on the present set.
if [ -n "$installed_plugins" ]; then
  while IFS= read -r spec; do
    [ -z "$spec" ] && continue
    keep=0
    for d in "${present_plugins[@]}"; do
      [ "$d" = "$spec" ] && keep=1 && break
    done
    if [ "$keep" -eq 0 ]; then
      echo "claude-plugins: uninstalling $spec"
      claude plugin uninstall "$spec"
    fi
  done <<< "$installed_plugins"
fi

# Remove marketplaces no desired plugin references.
existing_marketplaces="$(read_keys "$known" 'keys[]')"
if [ -n "$existing_marketplaces" ]; then
  while IFS= read -r mp; do
    [ -z "$mp" ] && continue
    if [ -z "${desired_marketplaces[$mp]:-}" ]; then
      echo "claude-plugins: removing marketplace $mp"
      claude plugin marketplace remove "$mp"
    fi
  done <<< "$existing_marketplaces"
fi
