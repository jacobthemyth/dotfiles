#!/usr/bin/env bash
# Plan (or with --yes, carry out) the removal of dead branches and their
# worktrees in the repository containing the current directory.

set -eo pipefail

usage="usage: git cleanup [--yes] [--closed]
  Dry run by default: prints a plan, changes nothing. --yes carries it out.
  --closed also deletes the branches of closed PRs (otherwise only their worktrees go).
  A dry run may fetch PR heads (refs/pull/N/head) from origin.
  Dispositions: delete (branch and worktree), worktree (worktree only), skip (left alone)."

yes=0
closed=0
for arg in "$@"; do
  case "$arg" in
    --yes) yes=1 ;;
    --closed) closed=1 ;;
    -h | --help)
      echo "$usage"
      exit 0
      ;;
    *)
      echo "$usage" >&2
      exit 2
      ;;
  esac
done

main_wt="$(git worktree list --porcelain | sed -n '1s/^worktree //p')"
[ -n "$main_wt" ] || { echo "git-cleanup: not in a git repository" >&2; exit 2; }

# Linked worktrees that have a branch, as parallel arrays (bash 3.2: no
# associative arrays). Detached and prunable entries are left out.
wt_paths=()
wt_branches=()
wt_locked=()

load_worktrees() {
  local line path="" branch="" prunable=0 locked=0
  wt_paths=()
  wt_branches=()
  wt_locked=()
  while IFS= read -r line; do
    case "$line" in
      "worktree "*)
        path="${line#worktree }"
        branch=""
        prunable=0
        locked=0
        ;;
      "branch refs/heads/"*) branch="${line#branch refs/heads/}" ;;
      prunable*) prunable=1 ;;
      locked*) locked=1 ;;
      "")
        if [ -n "$branch" ] && [ "$prunable" -eq 0 ]; then
          wt_paths+=("$path")
          wt_branches+=("$branch")
          wt_locked+=("$locked")
        fi
        path=""
        branch=""
        prunable=0
        locked=0
        ;;
    esac
  done < <(git -C "$main_wt" worktree list --porcelain; echo)
}

# The default branch, only ever a branch that exists locally: origin/HEAD's
# target, else main, master, or init.defaultBranch. Exits 2 when none resolves.
default_branch() {
  local head name
  head="$(git -C "$main_wt" symbolic-ref --short -q refs/remotes/origin/HEAD || true)"
  head="${head#origin/}"
  for name in "$head" main master "$(git -C "$main_wt" config --get init.defaultBranch || true)"; do
    if [ -n "$name" ] && git -C "$main_wt" show-ref --verify -q "refs/heads/$name"; then
      echo "$name"
      return 0
    fi
  done
  echo "git cleanup: cannot determine the default branch (set origin/HEAD or init.defaultBranch)" >&2
  exit 2
}

current_branch() {
  git branch --show-current
}

# Path of the worktree that has <branch> checked out, or nothing.
worktree_of() {
  local i=0
  while [ "$i" -lt "${#wt_branches[@]}" ]; do
    if [ "${wt_branches[$i]}" = "$1" ]; then
      echo "${wt_paths[$i]}"
      return 0
    fi
    i=$((i + 1))
  done
}

# Whether the worktree for <branch> is locked.
worktree_locked() {
  local i=0
  while [ "$i" -lt "${#wt_branches[@]}" ]; do
    if [ "${wt_branches[$i]}" = "$1" ]; then
      [ "${wt_locked[$i]}" -eq 1 ]
      return
    fi
    i=$((i + 1))
  done
  return 1
}

# Number of changed or untracked files in the worktree at <path>.
dirty_count() {
  git -C "$1" status --porcelain --untracked-files=normal --ignore-submodules=none | wc -l | tr -d ' '
}

is_dirty() {
  [ "$(dirty_count "$1")" -gt 0 ]
}

# Reachable from the default branch, and not merely sitting at its tip.
ancestry_merged() {
  [ "$(git -C "$main_wt" rev-parse "refs/heads/$1")" != "$(git -C "$main_wt" rev-parse "refs/heads/$default")" ] &&
    git -C "$main_wt" merge-base --is-ancestor "refs/heads/$1" "refs/heads/$default"
}

# Whether one commit holding the branch's whole diff is already in the default
# branch (a squash merge leaves an equivalent patch there).
squash_merged() {
  local base probe
  base="$(git -C "$main_wt" merge-base "refs/heads/$default" "refs/heads/$1")" || return 1
  probe="$(git -C "$main_wt" commit-tree "refs/heads/$1^{tree}" -p "$base" -m _)"
  case "$(git -C "$main_wt" cherry "refs/heads/$default" "$probe")" in
    -*) return 0 ;;
    *) return 1 ;;
  esac
}

ahead_count() {
  git -C "$main_wt" rev-list --count "refs/heads/$default..refs/heads/$1"
}

# <owner>/<repo> of origin when it is a GitHub remote, else nothing.
origin_slug() {
  git -C "$main_wt" config --get remote.origin.url 2> /dev/null |
    sed -n -E 's#^.*github\.com[:/]+([^/]+)/([^/]+)$#\1/\2#p' |
    sed -e 's#\.git$##' -e 's#/$##'
}

# Whether the gh enhancement can run: gh and jq installed, gh signed in, and
# origin on GitHub.
gh_available() {
  command -v gh > /dev/null && command -v jq > /dev/null || return 1
  [ -n "$(origin_slug)" ] || return 1
  gh auth status --hostname github.com > /dev/null 2>&1
}

# Newest PR per branch, from one GraphQL request per 50 branches. Fills the
# parallel arrays pr_branch/pr_state/pr_number (branches without a PR are left
# out). Any failure clears gh_ok, so the run falls back to git alone.
pr_branch=()
pr_state=()
pr_number=()
pr_oid=()

fetch_pr_states() {
  local slug owner repo q resp parsed key st num oid idx
  slug="$(origin_slug)"
  owner="${slug%%/*}"
  repo="${slug#*/}"
  pr_branch=()
  pr_state=()
  pr_number=()
  pr_oid=()
  while [ "$#" -gt 0 ]; do
    local batch=("$1")
    shift
    while [ "${#batch[@]}" -lt 50 ] && [ "$#" -gt 0 ]; do
      batch+=("$1")
      shift
    done
    q="$(jq -nr --arg o "$owner" --arg r "$repo" '
      "{ repository(owner: \($o | @json), name: \($r | @json)) { "
      + ([$ARGS.positional | to_entries[]
          | "b\(.key): pullRequests(headRefName: \(.value | @json), last: 1, orderBy: {field: CREATED_AT, direction: ASC}, states: [OPEN, MERGED, CLOSED]) { nodes { number state headRefOid } }"]
         | join(" "))
      + " } }"' --args "${batch[@]}")" || { gh_ok=0; return 1; }
    resp="$(gh api graphql -f query="$q")" || { gh_ok=0; return 1; }
    parsed="$(printf '%s' "$resp" | jq -r '.data.repository | to_entries[]
      | select(.value.nodes[0] != null)
      | "\(.key)\t\(.value.nodes[0].state)\t\(.value.nodes[0].number)\t\(.value.nodes[0].headRefOid)"')" || { gh_ok=0; return 1; }
    while IFS=$'\t' read -r key st num oid; do
      [ -n "$key" ] || continue
      case "$key" in b[0-9]*) ;; *) continue ;; esac
      idx="${key#b}"
      pr_branch+=("${batch[$idx]}")
      pr_state+=("$st")
      pr_number+=("$num")
      pr_oid+=("$oid")
    done <<< "$parsed"
  done
}

# Sets pr_found_state, pr_found_number and pr_found_oid for <branch>; returns 1 without a PR.
find_pr() {
  local i=0
  while [ "$i" -lt "${#pr_branch[@]}" ]; do
    if [ "${pr_branch[$i]}" = "$1" ]; then
      pr_found_state="${pr_state[$i]}"
      pr_found_number="${pr_number[$i]}"
      pr_found_oid="${pr_oid[$i]}"
      return 0
    fi
    i=$((i + 1))
  done
  return 1
}

# Whether every local commit on <branch> is in the merged PR's head <oid>: the
# tip is that head, or the head is known locally and contains the tip. A head
# not known locally is fetched once from GitHub's refs/pull/<number>/head (into
# FETCH_HEAD only; no refs are created). A reused branch name or a fork's PR of
# the same name fails this and is judged by git.
pr_head_covers() {
  local tip
  tip="$(git -C "$main_wt" rev-parse "refs/heads/$1")"
  [ "$tip" = "$2" ] && return 0
  git -C "$main_wt" cat-file -e "$2^{commit}" 2> /dev/null ||
    {
      echo "git cleanup: fetching refs/pull/$3/head for $1" >&2
      GIT_TERMINAL_PROMPT=0 git -C "$main_wt" fetch -q origin "refs/pull/$3/head" > /dev/null 2>&1 || true
    }
  git -C "$main_wt" cat-file -e "$2^{commit}" 2> /dev/null &&
    git -C "$main_wt" merge-base --is-ancestor "$tip" "$2"
}

emit() {
  printf '%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "$4"
}

# Print the output line for <branch>; the default branch prints nothing.
# Rules run in order and the first match wins; PR-state rules follow the dirty rule.
classify() {
  local branch="$1" wt count have_pr
  [ "$branch" != "$default" ] || return 0
  wt="$(worktree_of "$branch")"

  have_pr=0
  [ "$gh_ok" -ne 1 ] || ! find_pr "$branch" || have_pr=1

  if [ "$branch" = "$(current_branch)" ]; then
    emit skip "$branch" "${wt:--}" "current"
  elif [ "$wt" = "$main_wt" ]; then
    emit skip "$branch" "$wt" "checked out in $main_wt"
  elif [ -n "$wt" ] && is_dirty "$wt"; then
    count="$(dirty_count "$wt")"
    emit skip "$branch" "$wt" "dirty, $count file$([ "$count" -eq 1 ] || echo s)"
  elif [ -n "$wt" ] && worktree_locked "$branch"; then
    emit skip "$branch" "$wt" "locked"
  elif [ "$have_pr" -eq 1 ] && [ "$pr_found_state" = MERGED ] &&
    pr_head_covers "$branch" "$pr_found_oid" "$pr_found_number"; then
    emit delete "$branch" "${wt:--}" "PR #$pr_found_number merged"
  elif [ "$have_pr" -eq 1 ] && [ "$pr_found_state" = CLOSED ] &&
    pr_head_covers "$branch" "$pr_found_oid" "$pr_found_number"; then
    if [ "$closed" -eq 1 ]; then
      emit delete "$branch" "${wt:--}" "closed PR #$pr_found_number"
    elif [ -n "$wt" ]; then
      emit worktree "$branch" "$wt" "closed PR #$pr_found_number, branch kept"
    else
      emit skip "$branch" "-" "closed PR #$pr_found_number, branch kept"
    fi
  elif [ "$have_pr" -eq 1 ] && [ "$pr_found_state" = OPEN ]; then
    emit skip "$branch" "${wt:--}" "open PR #$pr_found_number"
  elif ancestry_merged "$branch"; then
    emit delete "$branch" "${wt:--}" "ancestry-merged"
  elif squash_merged "$branch"; then
    emit delete "$branch" "${wt:--}" "squash-merged"
  elif [ "$(ahead_count "$branch")" -eq 0 ]; then
    emit delete "$branch" "${wt:--}" "zero commits ahead"
  else
    emit skip "$branch" "${wt:--}" "unmerged work"
  fi
}

failures=0

# Echo a command and run it; a failure is counted and returned, never fatal.
run() {
  local status=0
  echo "+ $*"
  "$@" || status=$?
  [ "$status" -eq 0 ] || failures=$((failures + 1))
  return "$status"
}

default="$(default_branch)" || exit 2

# Every local branch but the default gets classified, so those are the ones to ask about.
branches=()
while IFS= read -r branch; do
  [ "$branch" = "$default" ] || branches+=("$branch")
done < <(git -C "$main_wt" for-each-ref refs/heads --format='%(refname:lstrip=2)')

gh_ok=0
gh_failed=0
if gh_available; then
  gh_ok=1
  [ "${#branches[@]}" -eq 0 ] || fetch_pr_states "${branches[@]}" || gh_failed=1
fi

echo "repo: $main_wt  default: $default"
if [ "$gh_ok" -eq 1 ]; then
  echo "gh: $(origin_slug)"
elif [ "$gh_failed" -eq 1 ]; then
  echo "gh query failed: PR state unknown"
else
  echo "gh not available: PR state unknown"
fi

if [ "$yes" -eq 1 ]; then
  git -C "$main_wt" worktree prune -v 2>&1
else
  git -C "$main_wt" worktree prune --dry-run -v 2>&1
fi

load_worktrees

plan=()
for branch in ${branches[@]+"${branches[@]}"}; do
  line="$(classify "$branch")"
  [ -z "$line" ] || plan+=("$line")
done

[ "${#plan[@]}" -eq 0 ] || printf '%s\n' "${plan[@]}"

if [ "$yes" -eq 1 ]; then
  for line in ${plan[@]+"${plan[@]}"}; do
    IFS=$'\t' read -r disposition branch wt _ <<< "$line"
    [ "$disposition" != skip ] || continue
    if [ "$wt" != "-" ]; then
      run git -C "$main_wt" worktree remove "$wt" || continue
    fi
    [ "$disposition" != delete ] || { run git -C "$main_wt" branch -D "$branch" || true; }
  done
  [ "$failures" -eq 0 ] || exit 1
fi
