{
  "cleanupPeriodDays": 99999,
  "permissions": {
    "allow": [
      "Read(~/.claude/skills/avoid-ai-writing/SKILL.md)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "npx -y ccstatusline@latest",
    "padding": 0
  },
  "enabledPlugins": {
    "codex@openai-codex": true,
    "document-skills@anthropic-agent-skills": true,
    "simple-english@simple-english": true,
    "superpowers@claude-plugins-official": true,
    "beads@beads-marketplace": true,
    "tmux-agent-sidebar@hiroppy": true
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "simple-english": {
      "source": {
        "source": "github",
        "repo": "AminBlg/SimpleEnglish"
      }
    },
    "beads-marketplace": {
      "source": {
        "source": "github",
        "repo": "gastownhall/beads"
      }
    },
    "hiroppy": {
      "source": {
        "source": "directory",
        "path": "/Users/jake/.local/share/tmux/plugins/tmux-agent-sidebar-e2084067ab62"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "tui": "fullscreen",
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "modelSettings": {
    "claude-opus-4-8": {
      "effortLevel": "medium"
    },
    "claude-opus-5": {
      "effortLevel": "medium"
    }
  }
}
